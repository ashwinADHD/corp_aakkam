---
import Layout from './Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Icons from '../components/Icons.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    clientIndustry: string;
    service: string;
    resultMetric: string;
    pubDate: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | Case Study — Aakkam Corporate Solutions`} description={frontmatter.description}>
  
  <!-- Clean Light Header with Krasis Orange Accents -->
  <section class="bg-gradient-to-b from-orange-50/60 via-white to-slate-50 border-b border-slate-200/80 py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 mb-4">
        <span class="inline-block bg-orange-100 text-brand-orange text-[0.7rem] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-orange-200">
          Client Case Study
        </span>
        <span class="text-xs text-slate-400">•</span>
        <span class="text-xs text-slate-600 font-semibold">{frontmatter.service}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 mb-4 leading-tight">
        {frontmatter.title}
      </h1>
      <p class="text-slate-600 max-w-3xl text-base sm:text-lg leading-relaxed">
        {frontmatter.description}
      </p>

      <!-- Key Metrics Badge Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-8 pt-6 border-t border-slate-200/80 max-w-2xl text-xs">
        <div class="p-3.5 rounded-xl bg-white border border-slate-200">
          <span class="text-slate-400 block font-medium">Industry Sector</span>
          <span class="text-slate-900 font-bold text-sm">{frontmatter.clientIndustry}</span>
        </div>
        <div class="p-3.5 rounded-xl bg-white border border-slate-200">
          <span class="text-slate-400 block font-medium">Core Mandate</span>
          <span class="text-slate-900 font-bold text-sm">{frontmatter.service}</span>
        </div>
        <div class="p-3.5 rounded-xl bg-orange-50/50 border border-orange-200">
          <span class="text-brand-orange block font-medium">Impact Result</span>
          <span class="text-emerald-700 font-black text-sm">{frontmatter.resultMetric}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content & Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      
      <!-- Main Markdown Article -->
      <main class="lg:col-span-8 bg-white p-6 sm:p-10 rounded-2xl border border-slate-200/90 shadow-sm">
        <article class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-slate-900 prose-h2:text-2xl prose-h2:border-b prose-h2:border-slate-100 prose-h2:pb-2 prose-h3:text-lg prose-a:text-brand-orange prose-strong:text-slate-900 prose-ul:my-4 prose-li:my-1">
          <slot />
        </article>

        <div class="mt-10 pt-6 border-t border-slate-200 flex flex-wrap justify-between items-center gap-4 text-sm">
          <a href="/case-studies" class="inline-flex items-center gap-1.5 text-slate-700 hover:text-brand-orange font-bold transition-colors">
            <span>← Back to All Case Studies</span>
          </a>
          <a href="/contact" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-orange text-white font-bold hover:bg-brand-orangeHover shadow-md shadow-orange-500/20 active:scale-95 transition-all text-xs sm:text-sm">
            <span>Engage Our Advisory Desk</span>
            <Icons name="chevron-right" class="w-4 h-4" />
          </a>
        </div>
      </main>

      <!-- Sidebar -->
      <div class="lg:col-span-4">
        <Sidebar currentPath="/case-studies" />
      </div>

    </div>
  </div>

</Layout>
