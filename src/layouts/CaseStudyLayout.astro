---
import Layout from './Layout.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    clientIndustry: string;
    service: string;
    resultMetric: string;
    pubDate: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | Case Study — Aakkam Corporate Solutions`} description={frontmatter.description}>
  
  <!-- Case Study Hero Header -->
  <div class="bg-gradient-to-r from-slate-950 via-slate-900 to-blue-950 text-white py-14 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 mb-3">
        <span class="inline-block bg-red-600/90 text-white text-[0.7rem] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full">
          Client Case Study
        </span>
        <span class="text-xs text-slate-400">•</span>
        <span class="text-xs text-blue-400 font-semibold">{frontmatter.service}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
        {frontmatter.title}
      </h1>
      <p class="text-slate-300 max-w-3xl text-base sm:text-lg">
        {frontmatter.description}
      </p>

      <!-- Key Metrics Badge Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-8 pt-6 border-t border-slate-800/80 max-w-2xl text-xs">
        <div>
          <span class="text-slate-400 block font-medium">Industry Sector</span>
          <span class="text-white font-bold text-sm">{frontmatter.clientIndustry}</span>
        </div>
        <div>
          <span class="text-slate-400 block font-medium">Core Mandate</span>
          <span class="text-white font-bold text-sm">{frontmatter.service}</span>
        </div>
        <div>
          <span class="text-slate-400 block font-medium">Impact Result</span>
          <span class="text-green-400 font-extrabold text-sm">{frontmatter.resultMetric}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Content & Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Main Markdown Article -->
      <main class="lg:col-span-8 bg-white p-8 sm:p-10 rounded-2xl border border-slate-200/90 shadow-sm">
        <article class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-slate-900 prose-h2:text-2xl prose-h2:border-b prose-h2:border-slate-100 prose-h2:pb-2 prose-h3:text-lg prose-a:text-blue-600 prose-strong:text-slate-900 prose-ul:my-4 prose-li:my-1">
          <slot />
        </article>

        <div class="mt-10 pt-6 border-t border-slate-200 flex justify-between items-center text-sm">
          <a href="/case-studies" class="text-blue-600 hover:text-blue-800 font-semibold">
            ← Back to All Case Studies
          </a>
          <a href="/contact" class="inline-flex items-center px-4 py-2 rounded-lg bg-red-600 text-white font-bold hover:bg-red-700 transition-colors">
            Engage Our Advisory Desk →
          </a>
        </div>
      </main>

      <!-- Sidebar -->
      <div class="lg:col-span-4">
        <Sidebar currentPath="/case-studies" />
      </div>

    </div>
  </div>

</Layout>
