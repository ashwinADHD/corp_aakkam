---
import Icons from './Icons.astro';

const services = [
  { href: '/resource', label: 'Fund Raising Solutions' },
  { href: '/sick', label: 'Sick Industries Revival' },
  { href: '/project', label: 'Project Preparation & Appraisal' },
  { href: '/due', label: 'Due Diligence' },
  { href: '/advisory', label: 'M & A Advisory Solutions' },
  { href: '/ipo', label: 'IPO Advisory Services' },
  { href: '/venture', label: 'Venture Capital Funding' },
  { href: '/tax', label: 'Corporate Tax Planning' },
];

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Our Firm' },
  { href: '/services', label: 'Services Directory' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/contact', label: 'Contact Us' },
];
---

<footer class="bg-slate-900 text-slate-300 mt-auto border-t-4 border-brand-orange">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-1 space-y-4">
        <div class="text-white font-black text-xl tracking-tight">
          AAKKAM <span class="text-brand-orange">CORPORATE</span> SOLUTIONS
        </div>
        <p class="text-xs leading-relaxed text-slate-400">
          A premier financial consulting and advisory firm committed to maximizing client satisfaction through innovative, transparent, and need-based institutional capital solutions.
        </p>
        <div class="text-xs text-slate-400 space-y-2 pt-2 border-t border-slate-800">
          <p class="font-semibold text-slate-200">Registered Office:</p>
          <p class="text-slate-300 leading-relaxed">No:3, 2nd Floor, Swaminathan Street, West Mambalam, Chennai - 600 033, India</p>
          <div class="pt-2 space-y-1.5">
            <p class="flex items-center gap-2">
              <span class="text-brand-orange shrink-0"><Icons name="phone" class="w-3.5 h-3.5" /></span>
              <span class="text-slate-400 font-medium">Hotline:</span> 
              <a href="tel:+917010311971" class="text-white hover:text-brand-orange hover:underline">+91 70103 11971</a>
            </p>
            <p class="flex items-center gap-2">
              <span class="text-emerald-400 shrink-0"><Icons name="whatsapp" class="w-3.5 h-3.5" /></span>
              <span class="text-slate-400 font-medium">WhatsApp:</span> 
              <a 
                href="https://wa.me/917010311971?text=Hello%20Aakkam%20Corporate%20Solutions%2C%20I%20would%20like%20to%20connect%20regarding%20corporate%20advisory%20services."
                target="_blank"
                rel="noopener noreferrer"
                class="text-emerald-400 hover:underline"
              >
                +91 70103 11971
              </a>
            </p>
            <p class="flex items-center gap-2">
              <span class="text-brand-orange shrink-0"><Icons name="mail" class="w-3.5 h-3.5" /></span>
              <span class="text-slate-400 font-medium">Email:</span> 
              <a href="mailto:ceo@aakkamcorp.com" class="text-white hover:text-brand-orange hover:underline">ceo@aakkamcorp.com</a>
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-bold text-sm uppercase tracking-wider mb-4 border-b border-slate-800 pb-2 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
          Company Navigation
        </h3>
        <ul class="space-y-2 text-xs">
          {links.map((link) => (
            <li>
              <a href={link.href} class="hover:text-brand-orange hover:translate-x-1 inline-flex items-center gap-1.5 transition-all text-slate-400">
                <Icons name="chevron-right" class="w-3 h-3 text-brand-orange" />
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Core Practice Areas -->
      <div class="md:col-span-2">
        <h3 class="text-white font-bold text-sm uppercase tracking-wider mb-4 border-b border-slate-800 pb-2 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
          Advisory Disciplines & Practice Areas
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
          {services.map((svc) => (
            <a href={svc.href} class="text-slate-400 hover:text-brand-orange hover:translate-x-1 transition-all py-1 inline-flex items-center gap-1.5">
              <span class="text-brand-orange">•</span>
              <span>{svc.label}</span>
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Compliance -->
    <div class="mt-12 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-4">
      <p>&copy; {new Date().getFullYear()} Aakkam Corporate Solutions. All Rights Reserved.</p>
      <div class="flex space-x-6">
        <a href="/about" class="hover:text-brand-orange transition-colors">Integrity & Confidentiality Policy</a>
        <a href="/contact" class="hover:text-brand-orange transition-colors">Client Advisory Desk</a>
      </div>
    </div>
  </div>
</footer>
