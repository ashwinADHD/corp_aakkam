---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/services', label: 'Services' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/contact', label: 'Contact Us' },
];
---

<!-- Top Contact Bar: Optimized for Mobile & Desktop -->
<aside class="bg-slate-900 text-slate-300 text-xs py-2 px-3 sm:px-6 border-b border-slate-800" aria-label="Quick contact information">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-1.5 sm:gap-4">
    <!-- Location (Truncated cleanly on very small screens) -->
    <div class="flex items-center gap-1.5 text-center sm:text-left text-[0.7rem] sm:text-xs text-slate-400">
      <span class="text-red-500 shrink-0">📍</span>
      <span>West Mambalam, Chennai - 600 033, India</span>
    </div>
    
    <!-- Phone & Email Direct Action Links -->
    <div class="flex items-center justify-center gap-3 sm:gap-4 text-[0.75rem] sm:text-xs">
      <a href="tel:+917010311971" class="text-white hover:text-red-400 flex items-center gap-1 font-bold transition-colors py-0.5">
        <span class="text-red-500">📱</span>
        <span>+91 70103 11971</span>
      </a>
      <span class="text-slate-700 hidden xs:inline">|</span>
      <a href="mailto:ceo@aakkamcorp.com" class="text-slate-300 hover:text-white flex items-center gap-1 transition-colors py-0.5">
        <span class="text-blue-400">✉️</span>
        <span class="hidden sm:inline">ceo@aakkamcorp.com</span>
        <span class="sm:hidden">Email</span>
      </a>
    </div>
  </div>
</aside>

<!-- Main Header & Navigation -->
<header class="bg-white/95 backdrop-blur-md sticky top-0 z-50 border-b border-slate-200/80 shadow-xs transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 sm:h-20 gap-2">
      
      <!-- Brand Logo: Fluid Size for Mobile to Desktop -->
      <a href="/" class="flex flex-col group min-w-0 pr-2">
        <span class="text-base xs:text-lg sm:text-xl lg:text-2xl font-black tracking-tight text-slate-900 group-hover:text-slate-800 transition-colors truncate">
          AAKKAM <span class="text-red-600">CORPORATE</span> SOLUTIONS
        </span>
        <span class="text-[0.6rem] sm:text-[0.7rem] uppercase tracking-wider font-semibold text-slate-500 -mt-0.5 sm:mt-0 truncate">
          Financial Consulting & Advisory Services
        </span>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2 shrink-0" aria-label="Desktop Navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 lg:px-4 py-2 rounded-lg text-sm font-semibold transition-all ${
                isActive
                  ? 'bg-slate-900 text-white shadow-xs'
                  : 'text-slate-700 hover:text-blue-600 hover:bg-slate-100'
              }`}
            >
              {link.label}
            </a>
          );
        })}
        <div class="pl-2 lg:pl-3">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-4 py-2.5 text-xs lg:text-sm font-bold text-white bg-red-600 hover:bg-red-700 active:scale-[0.98] rounded-lg shadow-sm hover:shadow transition-all shrink-0"
          >
            Get Consultation →
          </a>
        </div>
      </nav>

      <!-- Mobile Hamburger Button: Large Touch Target (44px min) -->
      <div class="md:hidden flex items-center shrink-0">
        <button
          id="mobile-menu-btn"
          type="button"
          class="inline-flex items-center justify-center p-2.5 rounded-lg text-slate-700 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <!-- Hamburger Icon -->
          <svg id="menu-icon-bars" class="h-6 w-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close Icon -->
          <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu with Large Touch-Friendly Targets -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-1.5 shadow-xl transition-all"
    aria-label="Mobile Navigation"
  >
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`flex items-center justify-between px-4 py-3 rounded-lg text-base font-semibold transition-colors ${
            isActive
              ? 'bg-slate-900 text-white'
              : 'text-slate-800 hover:bg-slate-100 hover:text-blue-600'
          }`}
        >
          <span>{link.label}</span>
          <span class="text-xs opacity-60">→</span>
        </a>
      );
    })}
    <div class="pt-3 border-t border-slate-100 mt-2 space-y-2">
      <a
        href="/contact"
        class="block w-full text-center px-4 py-3 text-sm font-bold text-white bg-red-600 hover:bg-red-700 active:scale-[0.98] rounded-xl shadow transition-all"
      >
        Request Advisory Consultation
      </a>
      <a
        href="tel:+917010311971"
        class="flex items-center justify-center gap-2 w-full text-center px-4 py-3 text-sm font-bold text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-all"
      >
        <span>📱 Tap to Call: +91 70103 11971</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const barsIcon = document.getElementById('menu-icon-bars');
  const closeIcon = document.getElementById('menu-icon-close');

  if (btn && menu && barsIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      barsIcon.classList.toggle('hidden', !isHidden);
      closeIcon.classList.toggle('hidden', isHidden);
      btn.setAttribute('aria-expanded', (!isHidden).toString());
    });
  }
</script>
