---
import Icons from './Icons.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/services', label: 'Services' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/contact', label: 'Contact Us' },
];
---

<!-- Top Contact Bar: Optimized for Mobile & Desktop with Vector Icons -->
<aside class="bg-slate-900 text-slate-300 text-xs py-2.5 px-3 sm:px-6 border-b border-slate-800" aria-label="Quick contact information">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2 sm:gap-4">
    <!-- Location -->
    <div class="flex items-center gap-1.5 text-center sm:text-left text-[0.7rem] sm:text-xs text-slate-400">
      <span class="text-brand-orange shrink-0"><Icons name="map-pin" class="w-3.5 h-3.5" /></span>
      <span>West Mambalam, Chennai - 600 033, India</span>
    </div>
    
    <!-- Phone, WhatsApp & Email Direct Action Links -->
    <div class="flex items-center justify-center flex-wrap gap-3 sm:gap-5 text-[0.75rem] sm:text-xs">
      <a href="tel:+917010311971" class="text-white hover:text-brand-orange flex items-center gap-1.5 font-bold transition-colors py-0.5">
        <span class="text-brand-orange"><Icons name="phone" class="w-3.5 h-3.5" /></span>
        <span>+91 70103 11971</span>
      </a>
      <span class="text-slate-700 hidden xs:inline">|</span>
      <a 
        href="https://wa.me/917010311971?text=Hello%20Aakkam%20Corporate%20Solutions%2C%20I%20would%20like%20to%20connect%20regarding%20corporate%20advisory%20services."
        target="_blank"
        rel="noopener noreferrer"
        class="text-emerald-400 hover:text-emerald-300 flex items-center gap-1.5 font-bold transition-colors py-0.5"
      >
        <span class="text-emerald-400"><Icons name="whatsapp" class="w-3.5 h-3.5" /></span>
        <span>WhatsApp</span>
      </a>
      <span class="text-slate-700 hidden xs:inline">|</span>
      <a href="mailto:ceo@aakkamcorp.com" class="text-slate-300 hover:text-brand-orange flex items-center gap-1.5 transition-colors py-0.5">
        <span class="text-brand-orange"><Icons name="mail" class="w-3.5 h-3.5" /></span>
        <span class="hidden sm:inline">ceo@aakkamcorp.com</span>
        <span class="sm:hidden">Email</span>
      </a>
    </div>
  </div>
</aside>

<!-- Main Header & Navigation -->
<header class="bg-white/95 backdrop-blur-md sticky top-0 z-50 border-b border-slate-200/80 shadow-xs transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 sm:h-20 gap-2">
      
      <!-- Brand Logo: Krasis Clean Typography & Orange Accent -->
      <a href="/" class="flex flex-col group min-w-0 pr-2">
        <span class="text-base xs:text-lg sm:text-xl lg:text-2xl font-black tracking-tight text-slate-900 group-hover:text-slate-800 transition-colors truncate">
          AAKKAM <span class="text-brand-orange">CORPORATE</span> SOLUTIONS
        </span>
        <span class="text-[0.6rem] sm:text-[0.7rem] uppercase tracking-wider font-semibold text-slate-500 -mt-0.5 sm:mt-0 truncate">
          Financial Consulting & Advisory Services
        </span>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2 shrink-0" aria-label="Desktop Navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 lg:px-4 py-2 rounded-xl text-sm font-semibold transition-all ${
                isActive
                  ? 'bg-orange-50 text-brand-orange font-bold border border-orange-200/80'
                  : 'text-slate-700 hover:text-brand-orange hover:bg-slate-50'
              }`}
            >
              {link.label}
            </a>
          );
        })}
        <div class="pl-2 lg:pl-3">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-1.5 px-4 lg:px-5 py-2.5 text-xs lg:text-sm font-bold text-white bg-brand-orange hover:bg-brand-orangeHover active:scale-[0.98] rounded-xl shadow-md shadow-orange-500/20 transition-all shrink-0"
          >
            <span>Reach Out</span>
            <Icons name="chevron-right" class="w-3.5 h-3.5" />
          </a>
        </div>
      </nav>

      <!-- Mobile Hamburger Button -->
      <div class="md:hidden flex items-center shrink-0">
        <button
          id="mobile-menu-btn"
          type="button"
          class="inline-flex items-center justify-center p-2.5 rounded-xl text-slate-700 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-orange transition-colors"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <!-- Hamburger Icon -->
          <svg id="menu-icon-bars" class="h-6 w-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close Icon -->
          <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-1.5 shadow-xl transition-all"
    aria-label="Mobile Navigation"
  >
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`flex items-center justify-between px-4 py-3 rounded-xl text-base font-semibold transition-colors ${
            isActive
              ? 'bg-orange-50 text-brand-orange font-bold border border-orange-200/80'
              : 'text-slate-800 hover:bg-slate-100 hover:text-brand-orange'
          }`}
        >
          <span>{link.label}</span>
          <Icons name="chevron-right" class="w-4 h-4 opacity-60" />
        </a>
      );
    })}
    <div class="pt-3 border-t border-slate-100 mt-2 space-y-2">
      <a
        href="https://wa.me/917010311971?text=Hello%20Aakkam%20Corporate%20Solutions%2C%20I%20would%20like%20to%20connect%20regarding%20corporate%20advisory%20services."
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full text-center px-4 py-3 text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] rounded-xl shadow transition-all"
      >
        <Icons name="whatsapp" class="w-4 h-4" />
        <span>Chat on WhatsApp: +91 70103 11971</span>
      </a>
      <a
        href="tel:+917010311971"
        class="flex items-center justify-center gap-2 w-full text-center px-4 py-3 text-sm font-bold text-slate-900 bg-orange-50 hover:bg-orange-100 border border-orange-200 rounded-xl transition-all"
      >
        <Icons name="phone" class="w-4 h-4 text-brand-orange" />
        <span>Tap to Call: +91 70103 11971</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const barsIcon = document.getElementById('menu-icon-bars');
  const closeIcon = document.getElementById('menu-icon-close');

  if (btn && menu && barsIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      barsIcon.classList.toggle('hidden', !isHidden);
      closeIcon.classList.toggle('hidden', isHidden);
      btn.setAttribute('aria-expanded', (!isHidden).toString());
    });
  }
</script>
