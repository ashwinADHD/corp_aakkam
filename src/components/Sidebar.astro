---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const services = [
  { href: '/resource', label: 'Fund Raising Solutions', icon: '💰' },
  { href: '/sick', label: 'Sick Industries Revival', icon: '🔄' },
  { href: '/project', label: 'Project Preparation & Appraisal', icon: '📋' },
  { href: '/due', label: 'Due Diligence', icon: '🔍' },
  { href: '/advisory', label: 'M & A Advisory Solutions', icon: '🤝' },
  { href: '/ipo', label: 'IPO Advisory Services', icon: '🔔' },
  { href: '/venture', label: 'Venture Capital Funding', icon: '🚀' },
  { href: '/tax', label: 'Corporate Tax Planning', icon: '📑' },
];
---

<aside class="space-y-6 lg:sticky lg:top-28" aria-label="Advisory Practices Sidebar">
  
  <!-- Direct Mobile Call Quick-Action Card (Prominent on Smartphone screens) -->
  <div class="block lg:hidden bg-gradient-to-r from-red-600 to-red-700 text-white p-4 sm:p-5 rounded-2xl shadow-md">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="text-[0.7rem] uppercase tracking-wider font-bold text-red-200">Need Immediate Advisory?</p>
        <p class="text-sm font-black">Speak With Our Leadership Desk</p>
      </div>
      <a
        href="tel:+917010311971"
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-white text-red-700 text-xs font-black shadow-sm active:scale-95 shrink-0"
      >
        <span>📞 Call Now</span>
      </a>
    </div>
  </div>

  <!-- Practice Areas Navigation Widget -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xs sm:shadow-sm overflow-hidden">
    <div class="bg-slate-900 text-white px-5 py-4 flex items-center justify-between">
      <h3 class="font-bold text-sm uppercase tracking-wide flex items-center gap-2">
        <span>📊</span> What Do We Do?
      </h3>
      <span class="text-xs text-slate-400">8 Practices</span>
    </div>
    
    <nav class="divide-y divide-slate-100" aria-label="Practice areas menu">
      {services.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            class={`flex items-center justify-between px-4 sm:px-5 py-3.5 text-xs sm:text-sm font-medium transition-all ${
              isActive
                ? 'bg-blue-50 text-blue-700 font-bold border-l-4 border-blue-600 pl-4'
                : 'text-slate-700 hover:bg-slate-50 hover:text-blue-600 hover:pl-6'
            }`}
          >
            <span class="flex items-center gap-2.5 truncate">
              <span class="shrink-0">{item.icon}</span>
              <span class="truncate">{item.label}</span>
            </span>
            <span class="text-xs text-slate-400 shrink-0">→</span>
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Direct Advisory Contact Widget -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xs sm:shadow-sm overflow-hidden">
    <div class="bg-slate-900 text-white px-5 py-4 flex items-center gap-2">
      <span class="text-red-500">📞</span>
      <h3 class="font-bold text-sm uppercase tracking-wide">Direct Advisory Desk</h3>
    </div>
    
    <div class="p-4 sm:p-5 space-y-4 text-xs">
      <div>
        <p class="text-slate-400 font-medium mb-1">Corporate Headquarters</p>
        <p class="text-slate-800 font-semibold leading-relaxed">
          No:3, 2nd Floor, Swaminathan Street, West Mambalam, Chennai - 600 033, India
        </p>
      </div>

      <div class="pt-3 border-t border-slate-100">
        <p class="text-slate-400 font-medium mb-1">Mobile Hotline</p>
        <a href="tel:+917010311971" class="text-sm font-bold text-red-600 hover:underline flex items-center gap-1.5 py-1">
          <span>📱</span> +91 70103 11971
        </a>
      </div>

      <div class="pt-3 border-t border-slate-100">
        <p class="text-slate-400 font-medium mb-1">Executive Email</p>
        <a href="mailto:ceo@aakkamcorp.com" class="text-sm font-semibold text-blue-600 hover:underline flex items-center gap-1.5 py-1">
          <span>✉️</span> ceo@aakkamcorp.com
        </a>
      </div>

      <div class="pt-3 border-t border-slate-100 bg-slate-50 -mx-4 sm:-mx-5 -mb-4 sm:-mb-5 p-4 rounded-b-2xl">
        <p class="text-[0.7rem] text-slate-500 leading-normal">
          🔒 <strong>Confidentiality First:</strong> We enforce strict Non-Disclosure Agreements (NDAs) before reviewing company financials or transaction targets.
        </p>
      </div>
    </div>
  </div>

</aside>
