---
import Icons from './Icons.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const services = [
  { href: '/resource', label: 'Fund Raising Solutions', icon: 'fund-raising' },
  { href: '/sick', label: 'Sick Industries Revival', icon: 'revival' },
  { href: '/project', label: 'Project Preparation & Appraisal', icon: 'project' },
  { href: '/due', label: 'Due Diligence', icon: 'diligence' },
  { href: '/advisory', label: 'M & A Advisory Solutions', icon: 'advisory' },
  { href: '/ipo', label: 'IPO Advisory Services', icon: 'ipo' },
  { href: '/venture', label: 'Venture Capital Funding', icon: 'venture' },
  { href: '/tax', label: 'Corporate Tax Planning', icon: 'tax' },
];
---

<aside class="space-y-6 lg:sticky lg:top-28" aria-label="Advisory Practices Sidebar">

  <!-- Practice Areas Navigation Widget -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden">
    <div class="bg-slate-900 text-white px-5 py-4 flex items-center justify-between">
      <h3 class="font-bold text-sm uppercase tracking-wider flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse"></span>
        Core Practice Areas
      </h3>
      <span class="text-xs font-semibold text-brand-orange bg-brand-orangeLight/10 px-2 py-0.5 rounded-full border border-brand-orange/30">
        8 Disciplines
      </span>
    </div>
    
    <nav class="divide-y divide-slate-100" aria-label="Practice areas menu">
      {services.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            class={`flex items-center justify-between px-4 sm:px-5 py-3.5 text-xs sm:text-sm font-medium transition-all group ${
              isActive
                ? 'bg-brand-orangeLight text-brand-orange font-bold border-l-4 border-brand-orange pl-4'
                : 'text-slate-700 hover:bg-slate-50 hover:text-brand-orange hover:pl-6'
            }`}
          >
            <span class="flex items-center gap-3 truncate">
              <span class={`shrink-0 transition-colors ${isActive ? 'text-brand-orange' : 'text-slate-400 group-hover:text-brand-orange'}`}>
                <Icons name={item.icon} class="w-4 h-4" />
              </span>
              <span class="truncate">{item.label}</span>
            </span>
            <Icons name="chevron-right" class={`w-4 h-4 shrink-0 transition-transform ${isActive ? 'text-brand-orange translate-x-0.5' : 'text-slate-300 group-hover:text-brand-orange group-hover:translate-x-1'}`} />
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Direct Advisory Contact Widget -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden">
    <div class="bg-slate-900 text-white px-5 py-4 flex items-center gap-2.5 border-b border-slate-800">
      <span class="text-brand-orange">
        <Icons name="phone" class="w-4 h-4" />
      </span>
      <h3 class="font-bold text-sm uppercase tracking-wider">Direct Advisory Desk</h3>
    </div>
    
    <div class="p-4 sm:p-5 space-y-4 text-xs">
      <div>
        <p class="text-slate-400 font-semibold uppercase tracking-wider text-[0.65rem] mb-1">Corporate Headquarters</p>
        <p class="text-slate-800 font-medium leading-relaxed flex items-start gap-2">
          <span class="text-brand-orange shrink-0 mt-0.5"><Icons name="map-pin" class="w-3.5 h-3.5" /></span>
          <span>No:3, 2nd Floor, Swaminathan Street, West Mambalam, Chennai - 600 033, India</span>
        </p>
      </div>

      <div class="pt-3 border-t border-slate-100">
        <p class="text-slate-400 font-semibold uppercase tracking-wider text-[0.65rem] mb-1">Direct Phone Call</p>
        <a href="tel:+917010311971" class="text-sm font-bold text-slate-900 hover:text-brand-orange flex items-center gap-2 py-1 transition-colors">
          <span class="text-brand-orange"><Icons name="phone" class="w-4 h-4" /></span>
          <span>+91 70103 11971</span>
        </a>
      </div>

      <div class="pt-3 border-t border-slate-100">
        <p class="text-slate-400 font-semibold uppercase tracking-wider text-[0.65rem] mb-1">WhatsApp Direct</p>
        <a 
          href="https://wa.me/917010311971?text=Hello%20Aakkam%20Corporate%20Solutions%2C%20I%20would%20like%20to%20connect%20regarding%20corporate%20advisory%20services."
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-bold text-emerald-600 hover:text-emerald-700 flex items-center gap-2 py-1 transition-colors"
        >
          <span class="text-emerald-600"><Icons name="whatsapp" class="w-4 h-4" /></span>
          <span>+91 70103 11971</span>
        </a>
      </div>

      <div class="pt-3 border-t border-slate-100">
        <p class="text-slate-400 font-semibold uppercase tracking-wider text-[0.65rem] mb-1">Executive Email</p>
        <a href="mailto:ceo@aakkamcorp.com" class="text-sm font-semibold text-slate-700 hover:text-brand-orange flex items-center gap-2 py-1 transition-colors">
          <span class="text-brand-orange"><Icons name="mail" class="w-4 h-4" /></span>
          <span>ceo@aakkamcorp.com</span>
        </a>
      </div>

      <div class="pt-3 border-t border-slate-100 bg-orange-50/40 -mx-4 sm:-mx-5 -mb-4 sm:-mb-5 p-4 rounded-b-2xl border-t border-orange-100">
        <p class="text-[0.7rem] text-slate-600 leading-normal flex items-start gap-1.5">
          <span class="text-brand-orange shrink-0 mt-0.5"><Icons name="shield" class="w-3.5 h-3.5" /></span>
          <span><strong>Confidentiality First:</strong> We enforce strict Non-Disclosure Agreements (NDAs) before reviewing company financials or transaction targets.</span>
        </p>
      </div>
    </div>
  </div>

</aside>
