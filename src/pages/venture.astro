---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Icons from '../components/Icons.astro';
---

<Layout
  title="Venture Capital Funding | Early & Growth Capital — Aakkam Corporate Solutions"
  description="Connect with premier venture capital funds, family offices, and angel networks. Financial forecasting, pitch deck formulation, valuation, and term sheet advisory."
>

  <!-- Clean Light Header with Krasis Orange Accents -->
  <section class="bg-gradient-to-b from-orange-50/60 via-white to-slate-50 border-b border-slate-200/80 py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-orange-100/80 text-brand-orange border border-orange-200 mb-4">
        Growth Capital
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Venture Capital Funding
      </h1>
      <p class="text-slate-600 max-w-2xl mt-4 text-base sm:text-lg leading-relaxed">
        Connecting innovative enterprises with institutional venture capital and strategic growth partners.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      
      <main class="lg:col-span-8 bg-white p-6 sm:p-10 rounded-2xl border border-slate-200/90 shadow-sm space-y-6">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight pb-3 border-b border-slate-100">
          Venture Capital Funding Solutions
        </h2>

        <p class="text-base text-slate-700 leading-relaxed text-left">
          High-growth enterprises and technology-driven startups require more than just financial capital—they need smart, strategic capital that accelerates scale, attracts elite talent, and opens doors to global markets.
        </p>

        <p class="text-base text-slate-700 leading-relaxed text-left">
          At Aakkam Corporate Solutions, our Venture Capital practice assists founders and mid-size growth companies in navigating the venture ecosystem. From early seed rounds to Series A and expansion financing, we bridge the gap between ambitious entrepreneurs and premier venture capital funds, institutional family offices, and strategic angel syndicates.
        </p>

        <h3 class="text-xl font-bold text-slate-900 pt-2">Our Venture Advisory Capabilities</h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2">
          <div class="p-6 rounded-2xl bg-orange-50/40 border border-orange-100">
            <div class="w-10 h-10 rounded-xl bg-orange-100 text-brand-orange flex items-center justify-center mb-3">
              <Icons name="project" class="w-5 h-5" />
            </div>
            <h4 class="font-bold text-slate-900 text-sm mb-1">Financial Models & Investor Decks</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Formulating institutional-grade financial forecasts, unit-economics models, and investor pitch decks that resonate with VC investment committees.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-orange-50/40 border border-orange-100">
            <div class="w-10 h-10 rounded-xl bg-orange-100 text-brand-orange flex items-center justify-center mb-3">
              <Icons name="fund-raising" class="w-5 h-5" />
            </div>
            <h4 class="font-bold text-slate-900 text-sm mb-1">Defensible Valuations</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Benchmarking pre-money and post-money valuations using discounted cash flows (DCF), comparable multiples, and venture stage metrics.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-xl bg-white text-slate-800 flex items-center justify-center mb-3 border border-slate-200">
              <Icons name="advisory" class="w-5 h-5" />
            </div>
            <h4 class="font-bold text-slate-900 text-sm mb-1">Curated Matchmaking</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Direct introductions to venture partners whose investment mandates specifically align with your sector, revenue model, and growth stage.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-xl bg-white text-slate-800 flex items-center justify-center mb-3 border border-slate-200">
              <Icons name="shield" class="w-5 h-5" />
            </div>
            <h4 class="font-bold text-slate-900 text-sm mb-1">Term Sheet Negotiation</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Advising founders through liquidation preferences, anti-dilution provisions, information rights, and board governance covenants.
            </p>
          </div>
        </div>

        <div class="pt-6 border-t border-slate-100 flex flex-wrap gap-4 items-center">
          <a
            href="/contact"
            class="inline-flex justify-center items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold text-white bg-brand-orange hover:bg-brand-orangeHover shadow-md shadow-orange-500/20 active:scale-[0.98] transition-all"
          >
            <span>Initiate Venture Funding Consultation</span>
            <Icons name="chevron-right" class="w-4 h-4" />
          </a>
          <a
            href="https://wa.me/917010311971?text=Hello%20Aakkam%2C%20I%20would%20like%20to%20discuss%20venture%20capital%20funding."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex justify-center items-center gap-2 px-5 py-3.5 rounded-xl text-sm font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 active:scale-[0.98] transition-all"
          >
            <Icons name="whatsapp" class="w-4 h-4 text-emerald-600" />
            <span>Chat on WhatsApp</span>
          </a>
        </div>
      </main>

      <div class="lg:col-span-4">
        <Sidebar currentPath="/venture" />
      </div>

    </div>
  </div>

</Layout>
