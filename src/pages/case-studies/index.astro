---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';

const caseStudies = [
  {
    title: "Turnaround & One Time Settlement for Distressed Auto-Ancillary Unit",
    description: "Negotiated a 42% debt haircut and saved 400 manufacturing jobs through consortium bank restructuring and OTS settlement.",
    service: "Sick Industries Revival",
    industry: "Automotive Ancillary",
    metric: "42% Debt Haircut",
    href: "/case-studies/debt-restructuring-revival",
  },
  {
    title: "Strategic M&A Acquisition & Due Diligence for Industrial Packaging Major",
    description: "Evaluated target enterprise, uncovered liabilities, and successfully concluded an ₹85 Cr acquisition at a 15% discount.",
    service: "M & A Advisory Solutions",
    industry: "Industrial Packaging",
    metric: "₹15 Cr Value Protected",
    href: "/case-studies/cross-border-ma-acquisition",
  },
];
---

<Layout
  title="Client Case Studies & Transaction Track Record | Aakkam Corporate Solutions"
  description="Explore proven transaction track records across debt restructuring, distressed asset turnaround, and strategic M&A acquisitions."
>

  <!-- Hero Header -->
  <div class="bg-gradient-to-r from-slate-950 via-slate-900 to-blue-950 text-white py-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <span class="inline-block bg-red-600 text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-3">
        Proven Execution
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Corporate Case Studies & Track Record
      </h1>
      <p class="text-slate-300 max-w-2xl mt-3 text-base sm:text-lg">
        Examine real-world examples of how Aakkam delivers quantifiable value, optimizes capital structures, and resolves high-stakes distress scenarios.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Case Studies List -->
      <main class="lg:col-span-8 space-y-6">
        {caseStudies.map((study) => (
          <article class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-blue-400 transition-all group">
            <div class="flex flex-wrap items-center gap-2 mb-3 text-xs">
              <span class="bg-blue-50 text-blue-700 font-bold px-2.5 py-1 rounded-md">
                {study.service}
              </span>
              <span class="text-slate-400">•</span>
              <span class="text-slate-600 font-medium">{study.industry}</span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
              <a href={study.href}>{study.title}</a>
            </h2>

            <p class="text-slate-600 text-sm mt-2 leading-relaxed">
              {study.description}
            </p>

            <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
              <div class="text-xs">
                <span class="text-slate-400 block font-medium">Outcome Metric</span>
                <span class="text-green-600 font-bold text-sm">{study.metric}</span>
              </div>
              <a
                href={study.href}
                class="inline-flex items-center text-sm font-bold text-red-600 hover:text-red-700 group-hover:translate-x-1 transition-all"
              >
                Read Full Case Study →
              </a>
            </div>
          </article>
        ))}

        <div class="bg-slate-900 text-white p-8 rounded-2xl mt-8">
          <h3 class="text-xl font-bold mb-2">Have a Unique Transaction Requirement?</h3>
          <p class="text-slate-300 text-sm mb-4">
            Our senior partners are ready to discuss your recapitalization, fundraising, or acquisition mandate under strict non-disclosure.
          </p>
          <a
            href="/contact"
            class="inline-block px-5 py-2.5 rounded-lg bg-red-600 text-white font-bold text-sm hover:bg-red-700 transition-colors shadow-sm"
          >
            Initiate Confidential Discussion →
          </a>
        </div>
      </main>

      <!-- Sidebar -->
      <div class="lg:col-span-4">
        <Sidebar currentPath="/case-studies" />
      </div>

    </div>
  </div>

</Layout>
