---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Icons from '../../components/Icons.astro';

const caseStudies = [
  {
    title: "Turnaround & One Time Settlement for Distressed Auto-Ancillary Unit",
    description: "Negotiated a 42% debt haircut and saved 400 manufacturing jobs through consortium bank restructuring and OTS settlement.",
    service: "Sick Industries Revival",
    industry: "Automotive Ancillary",
    metric: "42% Debt Haircut",
    href: "/case-studies/debt-restructuring-revival",
  },
  {
    title: "Strategic M&A Acquisition & Due Diligence for Industrial Packaging Major",
    description: "Evaluated target enterprise, uncovered liabilities, and successfully concluded an ₹85 Cr acquisition at a 15% discount.",
    service: "M & A Advisory Solutions",
    industry: "Industrial Packaging",
    metric: "₹15 Cr Value Protected",
    href: "/case-studies/cross-border-ma-acquisition",
  },
];
---

<Layout
  title="Client Case Studies & Transaction Track Record | Aakkam Corporate Solutions"
  description="Explore proven transaction track records across debt restructuring, distressed asset turnaround, and strategic M&A acquisitions."
>

  <!-- Clean Light Header with Krasis Orange Accents -->
  <section class="bg-gradient-to-b from-orange-50/60 via-white to-slate-50 border-b border-slate-200/80 py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-orange-100/80 text-brand-orange border border-orange-200 mb-4">
        Proven Execution
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Corporate Case Studies & Track Record
      </h1>
      <p class="text-slate-600 max-w-2xl mt-4 text-base sm:text-lg leading-relaxed">
        Examine real-world examples of how Aakkam delivers quantifiable value, optimizes capital structures, and resolves high-stakes distress scenarios.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      
      <!-- Case Studies List -->
      <main class="lg:col-span-8 space-y-6">
        {caseStudies.map((study) => (
          <article class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-brand-orange transition-all group">
            <div class="flex flex-wrap items-center gap-2 mb-3 text-xs">
              <span class="bg-orange-50 text-brand-orange font-bold px-2.5 py-1 rounded-md border border-orange-100">
                {study.service}
              </span>
              <span class="text-slate-400">•</span>
              <span class="text-slate-600 font-medium">{study.industry}</span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-brand-orange transition-colors">
              <a href={study.href}>{study.title}</a>
            </h2>

            <p class="text-slate-600 text-sm mt-2 leading-relaxed">
              {study.description}
            </p>

            <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
              <div class="text-xs">
                <span class="text-slate-400 block font-medium">Outcome Metric</span>
                <span class="text-emerald-600 font-bold text-sm">{study.metric}</span>
              </div>
              <a
                href={study.href}
                class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-orange hover:text-brand-orangeHover group-hover:translate-x-1 transition-all"
              >
                <span>Read Full Case Study</span>
                <Icons name="chevron-right" class="w-4 h-4" />
              </a>
            </div>
          </article>
        ))}

        <div class="bg-gradient-to-br from-slate-900 to-slate-950 text-white p-6 sm:p-8 rounded-2xl border border-slate-800 shadow-sm mt-8 space-y-4">
          <div class="flex items-center gap-2 text-brand-orange text-xs font-bold uppercase tracking-wider">
            <Icons name="shield" class="w-4 h-4" />
            <span>Confidential Transaction Support</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-black text-white">Have a Unique Transaction Requirement?</h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed max-w-xl">
            Our senior partners are ready to discuss your recapitalization, fundraising, or acquisition mandate under strict bilateral non-disclosure agreements.
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-brand-orange text-white font-bold text-xs hover:bg-brand-orangeHover transition-colors shadow-md shadow-orange-500/20 active:scale-95"
            >
              <span>Reach Out via Call, Email or WhatsApp</span>
              <Icons name="chevron-right" class="w-3.5 h-3.5" />
            </a>
            <a
              href="https://wa.me/917010311971?text=Hello%20Aakkam%20Corporate%20Solutions%2C%20I%20would%20like%20to%20connect%20regarding%20corporate%20advisory%20services."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 text-white font-bold text-xs hover:bg-emerald-700 transition-colors shadow-sm active:scale-95"
            >
              <Icons name="whatsapp" class="w-4 h-4" />
              <span>WhatsApp Us</span>
            </a>
          </div>
        </div>
      </main>

      <!-- Sidebar -->
      <div class="lg:col-span-4">
        <Sidebar currentPath="/case-studies" />
      </div>

    </div>
  </div>

</Layout>
